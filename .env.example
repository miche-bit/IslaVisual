# Puerto (Railway lo asigna automáticamente, no lo toques en producción)
PORT=3000

# Rutas de datos persistentes.
# En local puedes dejarlas comentadas (usa ./data, ./uploads, ./backups por defecto).
# En Railway, monta UN volumen (ej: en /app/persist) y descomenta estas 3 líneas
# apuntando cada una a una subcarpeta DENTRO de ese volumen:

# DATA_DIR=/app/persist/data
# UPLOADS_DIR=/app/persist/uploads/photos
# BACKUP_DIR=/app/persist/backups
